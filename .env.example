# Database
POSTGRES_USER=algomentor
POSTGRES_PASSWORD=algomentor_secret
POSTGRES_DB=algomentor
DATABASE_URL=postgresql+asyncpg://algomentor:algomentor_secret@postgres:5432/algomentor

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# App
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
